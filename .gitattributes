# 统一换行符：仓库内用 LF，检出到 Windows 时转 CRLF
* text=auto eol=lf

# 二进制资源不做换行转换
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.jks binary
*.apk binary
*.so binary

# Gradle / Android
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.md text eol=lf
*.sh text eol=lf
